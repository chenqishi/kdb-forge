+"""Bounded real old/new category and condition checks. No persistent ES writes."""
+import argparse
+import copy
+import hashlib
+import json
+import os
+import time
+from pathlib import Path
+
+import requests
+
+from es817_independent_query_compare_20261005 import (
+    ALLOWED, ENDPOINTS, PAIRS, ROOT, make_clients, prepare, read_es,
+)
+
+CATEGORY_FIELDS = {'category_path', 'category_ids', 'cate_name'} | {
+    f'cate{level}_{kind}' for level in range(1, 5) for kind in ('name', 'id')}
+SOURCE_FIELDS = ['primary_category', 'audit_result', 'data_type', 'del_flag',
+                 'ext_info.from_file_name', 'quality_level', 'dataset', 'title',
+                 'insert_time', 'update_time']
+TARGETS = {'mercado': '运营问题类型-KYC 验证', 'payoneer': '平台入驻-noon',
+           'payoneer_olive': 'Noon', 'wayfair': '默认分组',
+           'mercado_local': '业务地区-墨西哥'}
+QUERIES = {'mercado': '我KYC上传一直失败，网页报错',
+           'payoneer': 'Noon平台入驻需要什么材料？',
+           'payoneer_olive': '在Noon平台入驻时填写的收款账户，后期可以修改吗？',
+           'wayfair': '要填Wayfair申请流程里的推荐码吗？',
+           'mercado_local': '墨西哥怎么入驻？'}
+
+
+def field_values(source, field):
+    if field in CATEGORY_FIELDS:
+        field = 'primary_category.' + field
+    elif field == 'from_file_name':
+        field = 'ext_info.from_file_name'
+    field = field.removesuffix('.keyword')
+    values = [source]
+    for part in field.split('.'):
+        next_values = []
+        for value in values:
+            if isinstance(value, dict) and part in value:
+                item = value[part]
+                next_values.extend(item if isinstance(item, list) else [item])
+        values = next_values
+    return [value for value in values if value is not None]
+
+
+def matches(source, groups, endpoint):
+    groups = copy.deepcopy(groups)
+    if not groups and endpoint == 'search':
+        groups = [{'quality_level': ['high'], 'data_type': ['qa']},
+                  {'audit_result': [1, 2], 'data_type': ['qa']}]
+    if endpoint == 'search':
+        for group in groups:
+            group.setdefault('audit_result', [1, 2, -1])
+    if not any('del_flag' in group for group in groups):
+        if not any(str(value) == '0' for value in field_values(source, 'del_flag')):
+            return False
+    return not groups or any(all(
+        any(str(actual) == str(expected) for actual in field_values(source, field)
+            for expected in (value if isinstance(value, list) else [value]))
+        for field, value in group.items()) for group in groups)
+
+
+def oracle_query(groups, endpoint, mapping):
+    groups = copy.deepcopy(groups)
+    if not groups and endpoint == 'search':
+        groups = [{'quality_level': ['high'], 'data_type': ['qa']},
+                  {'audit_result': [1, 2], 'data_type': ['qa']}]
+    if endpoint == 'search':
+        for group in groups:
+            group.setdefault('audit_result', [1, 2, -1])
+    branches = []
+    for group in groups:
+        clauses = []
+        for field, value in group.items():
+            if field in CATEGORY_FIELDS:
+                field = 'primary_category.' + field
+            elif field == 'from_file_name':
+                field = 'ext_info.from_file_name.keyword'
+            node = mapping
+            for part in field.split('.'):
+                node = node.get('properties', {}).get(part, {})
+            if node.get('type') == 'text' and 'keyword' in node.get('fields', {}):
+                field += '.keyword'
+            clauses.append({'terms': {field: value}} if isinstance(value, list)
+                           else {'term': {field: value}})
+        branches.append({'bool': {'filter': clauses}})
+    filters = []
+    if branches:
+        filters.append({'bool': {'should': branches, 'minimum_should_match': 1}})
+    if not any('del_flag' in group for group in groups):
+        filters.append({'term': {'del_flag': 0}})
+    return {'bool': {'filter': filters}}
+
+
+def build_cases(clients, discovery):
+    cases, fixtures = [], {}
+    for platform, (public, private, provider) in PAIRS.items():
+        fieldmap = discovery[platform]['old']['mapping']['properties']['category_path']
+        path_field = 'primary_category.category_path' + (
+            '.keyword' if fieldmap['type'] == 'text' else '')
+        hits = read_es(clients['old'], 'POST', '/' + public + '/_search', {
+            'size': 1, '_source': SOURCE_FIELDS, 'query': {'bool': {'filter': [
+                {'term': {path_field: TARGETS[platform]}}, {'term': {'data_type': 'qa'}},
+                {'terms': {'audit_result': [1, 2]}}, {'term': {'del_flag': 0}}]}}})['hits']['hits']
+        if not hits:
+            raise ValueError('no reviewed QA fixture in requested real category: ' + platform)
+        fixture = hits[0]
+        fixtures[platform] = fixture
+        category = fixture['_source']['primary_category']
+        leaf = category['category_ids'][-1] if isinstance(category['category_ids'], list) else category['category_ids']
+        fields = [('path', {'category_path': category['category_path']}),
+                  ('id_scalar', {'category_ids': leaf}),
+                  ('id_list', {'category_ids': [leaf]}),
+                  ('level1_name', {'cate1_name': category['cate1_name']}),
+                  ('qualified_path', {path_field: category['category_path']})]
+        for field in ('cate1_id', 'cate2_name', 'cate2_id'):
+            if category.get(field):
+                fields.append((field, {field: category[field]}))
+        definitions = [('search', 'qa', name, [{**condition, 'data_type': 'qa', 'audit_result': [1, 2]}])
+                       for name, condition in fields]
+        definitions += [('search', 'segment', name, [{**condition, 'data_type': 'segment'}])
+                        for name, condition in fields if name in ('path', 'id_scalar')]
+        definitions += [('web_search', 'web', name, [condition]) for name, condition in fields
+                        if name in ('path', 'id_scalar', 'qualified_path')]
+        definitions += [('web_search', 'web', 'absent_path', [{'category_path': '__absent_category_20261008__'}]),
+                        ('web_search', 'web', 'names_valid', [{'category_names': category.get('cate2_name') or category['cate1_name']}]),
+                        ('web_search', 'web', 'names_invalid', [{'category_names': '__absent_category_20261008__'}])]
+        if platform in ('mercado_local', 'payoneer_olive'):
+            alternative = '业务地区-巴西' if platform == 'mercado_local' else 'Bol'
+            for endpoint, kind in [('search', 'qa'), ('web_search', 'web')]:
+                definitions += [(endpoint, kind, 'path_union_list', [{'category_path': [category['category_path'], alternative]}]),
+                                (endpoint, kind, 'path_union_or', [{'category_path': category['category_path']}, {'category_path': alternative}]),
+                                (endpoint, kind, 'contradictory_and', [{'category_path': category['category_path'], 'cate1_name': '__absent_category_20261008__'}])]
+        if platform == 'mercado_local':
+            definitions += [('search', 'qa', 'audit_singleton', [{'category_path': category['category_path'], 'data_type': 'qa', 'audit_result': fixture['_source']['audit_result']}]),
+                            ('search', 'qa', 'audit_missing', [{'category_path': category['category_path'], 'data_type': 'qa'}]),
+                            ('search', 'qa', 'delete_explicit_0', [{'category_path': category['category_path'], 'data_type': 'qa', 'del_flag': 0}]),
+                            ('web_search', 'web', 'delete_explicit_1', [{'category_path': category['category_path'], 'del_flag': 1}]),
+                            ('search', 'qa', 'type_union', [{'category_path': category['category_path'], 'data_type': ['qa', 'segment']}]),
+                            ('search', 'qa', 'default_conditions', [])]
+            file_name = fixture['_source'].get('ext_info', {}).get('from_file_name')
+            if file_name:
+                definitions += [('web_search', 'web', 'file_and_category', [{'category_path': category['category_path'], 'from_file_name': file_name}])]
+        for endpoint, kind, name, groups in definitions:
+            expected = copy.deepcopy(groups)
+            if name == 'names_valid':
+                expected = [{'category_ids': leaf}]
+            elif name == 'names_invalid':
+                expected = [{'category_ids': '__absent_category_20261008__'}]
+            if endpoint == 'search':
+                body = {'text': QUERIES[platform], 'search_type': kind, 'top_k': 5,
+                        'score_threshold': 0.4, 'use_synonyms': True,
+                        'index_names': private + ',' + public, 'condition_dicts': groups}
+            else:
+                body = {'text': '', 'client': platform, 'index_names': public + ',' + private,
+                        'condition_dicts': groups, 'page_size': 10, 'page_num': 1,
+                        'score_threshold': -1}
+            cases.append({'case': platform + '-' + kind + '-' + name, 'platform': platform,
+                          'endpoint': endpoint, 'kind': kind, 'variant': name,
+                          'request': body, 'expected_groups': expected})
+    if len(cases) > 105:
+        raise ValueError('bounded matrix exceeded')
+    return cases, fixtures
+
+
+def capture_sources(client, indexes, ids, cache):
+    absent = sorted({identifier for identifier in ids if identifier not in cache})
+    for start in range(0, len(absent), 40):
+        chunk = absent[start:start + 40]
+        for identifier in chunk:
+            cache[identifier] = []
+        for index in indexes:
+            response = read_es(client, 'POST', '/' + index + '/_mget?_source_includes=' + ','.join(SOURCE_FIELDS), {
+                'ids': chunk})
+            for doc in response['docs']:
+                if doc.get('error'):
+                    raise RuntimeError('mget item error')
+                if doc.get('found'):
+                    cache[doc['_id']].append({'index': index, 'source': doc['_source']})
+    return {identifier: cache[identifier] for identifier in ids}
+
+
+def strip_vectors(value):
+    if isinstance(value, dict):
+        return {key: strip_vectors(item) for key, item in value.items() if 'embedding' not in key.lower()}
+    if isinstance(value, list):
+        return [strip_vectors(item) for item in value]
+    return value
+
+
+def resolve_sources(row, options):
+    if row.get('_index'):
+        options = [item for item in options if item['index'] == row['_index']]
+    elif row.get('dataset'):
+        options = [item for item in options if
+                   (item['source'].get('dataset') or item['index']) == row['dataset']]
+    if isinstance(row.get('primary_category'), dict):
+        options = [item for item in options if item['source'].get('primary_category') == row['primary_category']]
+    return options
+
+
+def request_endpoint(session, side, endpoint, body):
+    start = time.monotonic()
+    url = ENDPOINTS[side].removesuffix('/search') + '/' + endpoint
+    try:
+        response = session.post(url, json=body, timeout=60)
+        response.raise_for_status()
+        payload = response.json()
+        if not isinstance(payload.get('results'), list):
+            raise ValueError('missing results')
+        keys = []
+        for row in payload['results']:
+            identifier = row.get('id') if endpoint == 'search' else row.get('_id') or row.get('id')
+            if not identifier or row.get('error') or row.get('q') == '检索结果错误':
+                raise ValueError('HTTP200 error sentinel or empty identity')
+            keys.append((row.get('dataset'), identifier))
+        if len(set(keys)) != len(keys):
+            raise ValueError('duplicate returned identity')
+        return {'response': strip_vectors(payload), 'http_status': response.status_code,
+                'response_bytes': len(response.content), 'elapsed_s': round(time.monotonic() - start, 3)}
+    except Exception as exc:
+        return {'error_type': type(exc).__name__, 'reason': str(exc)[:200],
+                'elapsed_s': round(time.monotonic() - start, 3)}
+
+
+def evaluate(case, runs, clients, caches, mappings, counts):
+    public, private, provider = PAIRS[case['platform']]
+    evidence, keys = {}, {}
+    for side, client in [('old', clients['old']), ('new', clients[provider])]:
+        count = 0
+        for index in (public, private):
+            query = oracle_query(case['expected_groups'], case['endpoint'], mappings[(side, index)])
+            cache_key = (side, index, json.dumps(query, sort_keys=True))
+            if cache_key not in counts:
+                counts[cache_key] = read_es(client, 'POST', '/' + index + '/_count', {'query': query})['count']
+            count += counts[cache_key]
+        evidence[side] = {'expected_native_count': count, 'checked_hits': 0, 'violations': [], 'unresolved_ids': [], 'ambiguous_ids': [], 'shape_issues': []}
+        if 'response' not in runs[side]:
+            evidence[side]['service_error'] = runs[side].get('error_type')
+            continue
+        response = runs[side]['response']
+        rows = response['results']
+        identifiers = [row.get('id') if case['endpoint'] == 'search' else row.get('_id') or row.get('id') for row in rows]
+        sources = capture_sources(client, (public, private), identifiers, caches[(side, case['platform'])])
+        keys[side] = [(row.get('dataset'), identifier) for row, identifier in zip(rows, identifiers)]
+        for row, identifier in zip(rows, identifiers):
+            options = resolve_sources(row, sources[identifier])
+            if not options:
+                evidence[side]['unresolved_ids'].append(identifier)
+                continue
+            evidence[side]['checked_hits'] += 1
+            verdicts = [matches(option['source'], case['expected_groups'], case['endpoint']) for option in options]
+            if any(verdicts) and not all(verdicts):
+                evidence[side]['ambiguous_ids'].append(identifier)
+            elif not any(verdicts):
+                evidence[side]['violations'].append({'id': identifier, 'stored': options})
+            if not isinstance(row.get('primary_category'), dict):
+                evidence[side]['shape_issues'].append({'id': identifier, 'missing': 'primary_category'})
+        evidence[side]['returned_count'] = len(rows)
+        evidence[side]['zero_despite_existing_members'] = not rows and count > 0
+        if case['endpoint'] == 'web_search':
+            evidence[side]['actual_total'] = response['total_count']
+            evidence[side]['total_matches_oracle'] = response['total_count'] == count
+            evidence[side]['current_count_correct'] = response['current_count'] == len(rows)
+    if len(keys) == 2:
+        evidence['comparison'] = {'same_order': keys['old'] == keys['new'],
+                                  'same_set': set(keys['old']) == set(keys['new']),
+                                  'top1_same': keys['old'][:1] == keys['new'][:1],
+                                  'overlap': len(set(keys['old']) & set(keys['new']))}
+    return evidence
+
+
+def run(clients, output, cases):
+    if len(cases) > 105 or (output / 'paired_responses.private.json').exists():
+        raise ValueError('excess cases or existing results: refuse overwrite')
+    prepare(clients, output, titles=False)
+    mappings = {}
+    for index in ALLOWED:
+        provider = next(pair[2] for pair in PAIRS.values() if index in pair[:2])
+        for side, client in [('old', clients['old']), ('new', clients[provider])]:
+            mappings[(side, index)] = read_es(client, 'GET', '/' + index)[index]['mappings']
+    caches = {(side, platform): {} for side in ('old', 'new') for platform in PAIRS}
+    counts, raw, evidence = {}, [], []
+    with requests.Session() as session:
+        for position, case in enumerate(cases):
+            runs = {}
+            for side in (('old', 'new') if position % 2 == 0 else ('new', 'old')):
+                runs[side] = request_endpoint(session, side, case['endpoint'], case['request'])
+                time.sleep(0.15)
+            raw.append({**case, 'runs': runs})
+            (output / 'paired_responses.private.json').write_text(json.dumps(raw, ensure_ascii=False, indent=2))
+            checks = evaluate(case, runs, clients, caches, mappings, counts)
+            evidence.append({**case, 'checks': checks})
+            (output / 'condition_evidence.json').write_text(json.dumps(evidence, ensure_ascii=False, indent=2))
+            print(json.dumps({'case': case['case'], 'checks': {side: {
+                k: v for k, v in values.items() if k != 'violations'} | {'violations': len(values.get('violations', []))}
+                for side, values in checks.items() if side != 'comparison'},
+                'comparison': checks.get('comparison')}, ensure_ascii=False), flush=True)
+    statistics = {'paired_cases': len(evidence), 'service_requests': len(evidence) * 2, 'sides': {}}
+    for side in ('old', 'new'):
+        values = [row['checks'][side] for row in evidence]
+        statistics['sides'][side] = {
+            'checked_hits': sum(row['checked_hits'] for row in values),
+            'violating_hits': sum(len(row['violations']) for row in values),
+            'unresolved_hits': sum(len(row['unresolved_ids']) for row in values),
+            'service_errors': sum('service_error' in row for row in values),
+            'zero_with_existing_members_cases': sum(row.get('zero_despite_existing_members', False) for row in values),
+            'web_total_mismatch_cases': sum(not row['total_matches_oracle'] for row in values if 'total_matches_oracle' in row)}
+    (output / 'statistics.json').write_text(json.dumps(statistics, ensure_ascii=False, indent=2))
+    print(json.dumps(statistics), flush=True)
+
+
+def main():
+    os.umask(0o077)
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--phase', choices=['prepare', 'run'], required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    args.output.mkdir(mode=0o700, exist_ok=True)
+    clients = make_clients()
+    try:
+        hashes = {path: hashlib.sha256((ROOT / path).read_bytes()).hexdigest() for path in (
+            'knowledge_interface_tools/es8_search_interface.py', 'knowledge_interface_tools/search_index_data_interface.py',
+            'knowledge_database_search_service/src/knowledge_database_search_es.py')}
+        (args.output / 'implementation_hashes.json').write_text(json.dumps(hashes, indent=2))
+        if args.phase == 'prepare':
+            if (args.output / 'matrix.json').exists():
+                raise ValueError('refuse replacing prepared matrix')
+            cases, fixtures = build_cases(clients, json.loads((args.output / 'category_discovery.json').read_text()))
+            (args.output / 'matrix.json').write_text(json.dumps(cases, ensure_ascii=False, indent=2))
+            (args.output / 'fixtures.json').write_text(json.dumps(fixtures, ensure_ascii=False, indent=2))
+            print(json.dumps({'paired_cases': len(cases), 'fixtures': {platform: doc['_source']['primary_category'] for platform, doc in fixtures.items()}}, ensure_ascii=False))
+        else:
+            run(clients, args.output, json.loads((args.output / 'matrix.json').read_text()))
+    finally:
+        for client in clients.values():
+            client.session.close()
+
+
+if __name__ == '__main__':
+    main()
