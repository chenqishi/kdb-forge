{
  "es_version": "8.17",
  "index_name": "test_index",
  "vector_fields": {
    "indexes_embedding": 1024
  },
  "default_provider": "default",
  "providers": {
    "default": {
      "hosts": [
        "https://elasticsearch.example.invalid:9200"
      ],
      "username": "SET_CURRENT_USERNAME",
      "password": "SET_CURRENT_PASSWORD",
      "verify_certs": true,
      "request_timeout": 30
    }
  },
  "index_routes": {},
  "extra_params": {
    "recall_mode": "dual",
    "auto_update_mapping": false,
    "ensure_index_on_init": false
  }
}
