{
    "es_version": "8.17",
    "index_name": "test_case",
    "vector_fields": {
        "indexes_embedding": 1024
    },
    "default_provider": "serverless",
    "providers": {
        "serverless": {
            "hosts": ["https://your-serverless-endpoint:9200"],
            "username": "your-username",
            "password": "your-password",
            "verify_certs": false
        },
        "paas": {
            "hosts": ["https://your-paas-endpoint:9200"],
            "username": "your-username",
            "password": "your-password",
            "verify_certs": false
        }
    },
    "index_routes": {
        "*payoneer*": "paas"
    },
    "extra_params": {
        "recall_mode": "dual",
        "auto_update_mapping": false
    }
}
